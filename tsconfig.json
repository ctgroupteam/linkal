{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "typeRoots": [
      "./Linkal Tool/node_modules/@types"
    ],
    "paths": {
      "@/*": ["./Linkal Tool/*"],
      "react": ["./Linkal Tool/node_modules/@types/react"],
      "react-dom": ["./Linkal Tool/node_modules/@types/react-dom"]
    }
  },
  "include": [
    "Linkal Tool/**/*.ts",
    "Linkal Tool/**/*.tsx",
    "Linkal Tool/.next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "Linkal Tool/node_modules",
    "Linkal Admin/node_modules"
  ]
}
