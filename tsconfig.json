{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./Linkal Tool/*"]
    }
  },
  "include": [
    "*.d.ts",
    "Linkal Tool/*.d.ts",
    "Linkal Tool/**/*.d.ts",
    "Linkal Tool/next-env.d.ts",
    "Linkal Tool/**/*.ts",
    "Linkal Tool/**/*.tsx",
    "Linkal Tool/.next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "Linkal Tool/node_modules",
    "Linkal Admin/node_modules"
  ]
}
